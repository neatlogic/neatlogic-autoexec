<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="neatlogic.module.autoexec.dao.mapper.AutoexecCombopVersionMapper">

    <select id="checkAutoexecCombopVersionNameIsRepeat"
            parameterType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo" resultType="java.lang.Long">
        SELECT `id`
        FROM `autoexec_combop_version`
        WHERE `name` = #{name}
          AND `id` != #{id} LIMIT 1
    </select>

    <select id="getAutoexecCombopVersionById" parameterType="java.lang.Long"
            resultType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        SELECT `id`,
               `name`,
               `combop_id` AS combopId,
               `is_active` AS isActive,
               `version`,
               `status`,
               `reviewer`,
               `config` AS configStr,
               `lcd`,
               `lcu`
        FROM `autoexec_combop_version`
        WHERE `id` = #{value}
    </select>

    <select id="getAutoexecCombopVersionListByCombopId" parameterType="java.lang.Long"
            resultType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        SELECT `id`,
               `name`,
               `combop_id` AS combopId,
               `is_active` AS isActive,
               `version`,
               `status`,
               `reviewer`,
               `config` AS configStr,
               `lcd`,
               `lcu`
        FROM `autoexec_combop_version`
        WHERE `combop_id` = #{value}
    </select>

    <select id="getAutoexecCombopVersionListByIdList" parameterType="java.util.List"
            resultType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        SELECT `id`,
               `name`,
               `combop_id` AS combopId,
               `is_active` AS isActive,
               `version`,
               `status`,
               `reviewer`,
               `config` AS configStr,
               `lcd`,
               `lcu`
        FROM `autoexec_combop_version`
        WHERE `id` IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="getAutoexecCombopVersionList" parameterType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo"
            resultType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        SELECT `id`,
               `name`,
               `combop_id` AS combopId,
               `is_active` AS isActive,
               `version`,
               `status`,
               `reviewer`,
               `config` AS configStr,
               `lcd`,
               `lcu`
        FROM `autoexec_combop_version`
        WHERE `combop_id` = #{combopId}
        <choose>
            <when test="status == 'notPassed'">
                and `status` != 'passed'
            </when>
            <when test="status == 'passed'">
                and `status` = 'passed'
                and `is_active` = 0
            </when>
        </choose>
        <choose>
            <when test="status == 'notPassed'">
                order by `lcd` desc
            </when>
            <when test="status == 'passed'">
                order by `version` desc
            </when>
        </choose>
        LIMIT #{startNum}, #{pageSize}
    </select>

    <select id="getAutoexecCombopVersionCount" parameterType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo"
            resultType="int">
        SELECT count(1)
        FROM `autoexec_combop_version`
        WHERE `combop_id` = #{combopId}
        <choose>
            <when test="status == 'notPassed'">
                and `status` != 'passed'
            </when>
            <when test="status == 'passed'">
                and `status` = 'passed'
                and `is_active` = 0
            </when>
        </choose>
    </select>

    <select id="getAutoexecCombopVersionParamListByCombopVersionId" parameterType="java.lang.Long"
            resultType="neatlogic.framework.autoexec.dto.AutoexecParamVo">
        SELECT `key`,
               `name`,
               `default_value` AS defaultValue,
               `description`,
               `is_required`   AS isRequired,
               `type`,
               `sort`,
               `config`,
               `editable`
        FROM `autoexec_combop_version_param`
        WHERE `combop_version_id` = #{value}
        ORDER BY `sort`
    </select>

    <select id="getAutoexecCombopActiveVersionIdByCombopId" parameterType="java.lang.Long" resultType="java.lang.Long">
        SELECT `id`
        FROM `autoexec_combop_version`
        WHERE `combop_id` = #{value} and `is_active` = 1
    </select>

    <select id="getAutoexecCombopActiveVersionByCombopId" parameterType="java.lang.Long" resultType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        SELECT `id`,
               `name`,
               `combop_id` AS combopId,
               `is_active` AS isActive,
               `version`,
               `status`,
               `reviewer`,
               `config` AS configStr,
               `lcd`,
               `lcu`
        FROM `autoexec_combop_version`
        WHERE `combop_id` = #{value} and `is_active` = 1
    </select>

    <select id="getAutoexecCombopMaxVersionByCombopId" parameterType="java.lang.Long" resultType="java.lang.Integer">
        SELECT max(`version`)
        FROM `autoexec_combop_version`
        WHERE `combop_id` = #{value}
    </select>

    <select id="getAutoexecCombopMaxVersionIdByCombopIdAndStatus" parameterType="java.util.Map" resultType="java.lang.Long">
        SELECT
            max(`id`)
        FROM `autoexec_combop_version`
        WHERE combop_id = #{combopId}
          AND `status` = #{status}
    </select>

    <select id="getAutoexecCombopVersionCountForUpdateConfig" resultType="int">
        SELECT COUNT(1) FROM `autoexec_combop_version`
    </select>

    <select id="getAutoexecCombopVersionListForUpdateConfig" parameterType="neatlogic.framework.common.dto.BasePageVo" resultType="java.util.HashMap">
        SELECT
            `id`,
            `name`,
            `config`
        FROM `autoexec_combop_version`
        LIMIT #{startNum}, #{pageSize}
    </select>

    <insert id="insertAutoexecCombopVersion" parameterType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        INSERT INTO `autoexec_combop_version` (`id`,
                                               `name`,
                                               `combop_id`,
                                               `version`,
                                               `is_active`,
                                               `status`,
                                               `reviewer`,
                                               `config`,
                                               `lcd`,
                                               `lcu`)
        VALUES (#{id},
                #{name},
                #{combopId},
                #{version},
                #{isActive},
                #{status},
                #{reviewer},
                #{configStr, typeHandler=CompressHandler},
                NOW(3),
                #{lcu})
    </insert>

    <update id="updateAutoexecCombopVersionById" parameterType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        UPDATE `autoexec_combop_version`
        SET `name`             = #{name},
            `status`           = #{status},
            `config`           = #{configStr, typeHandler=CompressHandler},
            `lcu` = #{lcu},
            `lcd` = NOW(3)
        WHERE `id` = #{id}
    </update>

    <update id="updateAutoexecCombopVersionStatusById" parameterType="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        UPDATE `autoexec_combop_version`
        SET `status` = #{status},
            <if test="reviewer != null and reviewer != ''">
            `reviewer` = #{reviewer},
            </if>
            `lcu` = #{lcu},
            `lcd` = NOW(3)
        WHERE `id` = #{id}
    </update>

    <update id="disableAutoexecCombopVersionByCombopId" parameterType="java.lang.Long">
        UPDATE `autoexec_combop_version` SET `is_active` = 0 WHERE `combop_id` = #{value}
    </update>

    <update id="enableAutoexecCombopVersionById" parameterType="java.lang.Long">
        UPDATE `autoexec_combop_version` SET `is_active` = 1 WHERE `id` = #{value}
    </update>

    <update id="updateAutoexecCombopVersionConfigById" parameterType="java.util.Map">
        UPDATE `autoexec_combop_version` SET `config` = #{configStr, typeHandler=CompressHandler} WHERE `id` = #{id}
    </update>

    <delete id="deleteAutoexecCombopVersionByCombopId" parameterType="java.lang.Long">
        DELETE
        FROM `autoexec_combop_version`
        WHERE `combop_id` = #{value}
    </delete>

    <delete id="deleteAutoexecCombopVersionById" parameterType="java.lang.Long">
        DELETE
        FROM `autoexec_combop_version`
        WHERE `id` = #{value}
    </delete>

    <!-- 配置沿用框架压缩协议，显式解压以兼容驱动返回的不同文本 JDBC 类型。 -->
    <resultMap id="candidateVersion" type="neatlogic.framework.autoexec.dto.combop.AutoexecCombopVersionVo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="combopId" property="combopId"/>
        <result column="configStr" property="configStr" typeHandler="neatlogic.framework.dao.plugin.CompressHandler"/>
    </resultMap>
    <!-- 与组合工具执行授权保持一致，EXISTS 避免多条用户或团队授权重复候选。 -->
    <sql id="candidateFrom">
        FROM autoexec_combop a
        JOIN autoexec_combop_version v ON v.combop_id=a.id AND v.is_active=1 AND v.status='passed'
        WHERE a.is_active=1
        <if test="!all">
            AND (a.owner=#{auth.userUuid} OR EXISTS (
                SELECT 1 FROM autoexec_combop_authority c WHERE c.combop_id=a.id AND c.action='execute'
                AND ((c.type='common' AND c.uuid='alluser') OR (c.type='user' AND c.uuid=#{auth.userUuid})
                <if test="auth.teamUuidList != null and auth.teamUuidList.size > 0">
                    OR (c.type='team' AND c.uuid IN <foreach collection="auth.teamUuidList" item="uuid" open="(" separator="," close=")">#{uuid}</foreach>)
                </if>
                <if test="auth.roleUuidList != null and auth.roleUuidList.size > 0">
                    OR (c.type='role' AND c.uuid IN <foreach collection="auth.roleUuidList" item="uuid" open="(" separator="," close=")">#{uuid}</foreach>)
                </if>
                )
            ))
        </if>
        <if test="keyword != null and keyword != ''">AND (a.name LIKE CONCAT('%',#{keyword},'%') OR a.description LIKE CONCAT('%',#{keyword},'%'))</if>
        <if test="ids != null and ids.size > 0">AND a.id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></if>
    </sql>
    <select id="countExecutableVersions" resultType="int">SELECT COUNT(DISTINCT a.id) <include refid="candidateFrom"/></select>
    <select id="searchExecutableVersions" resultMap="candidateVersion">
        SELECT v.id,v.name,v.combop_id combopId,v.config configStr
        <include refid="candidateFrom"/>
        <if test="beforeId != null">AND a.id &lt; #{beforeId}</if>
        ORDER BY a.id DESC LIMIT #{size}
    </select>
</mapper>
