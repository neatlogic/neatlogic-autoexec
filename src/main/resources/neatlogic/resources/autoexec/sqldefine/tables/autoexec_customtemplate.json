{
  "moduleId": "autoexec",
  "name": "autoexec_customtemplate",
  "label": "自动化自定义模板",
  "description": "自动化自定义模板 可用于自动化相关的启用状态筛选、时间维度统计等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "id，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(255)",
      "description": "名称。"
    },
    {
      "name": "is_active",
      "type": "tinyint",
      "description": "是否激活。"
    },
    {
      "name": "template",
      "type": "longtext",
      "description": "html模板。"
    },
    {
      "name": "config",
      "type": "longtext",
      "description": "配置，json格式。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "首次创建时间。"
    },
    {
      "name": "fcu",
      "type": "char(32)",
      "description": "首次创建人。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "最近修改时间。"
    },
    {
      "name": "lcu",
      "type": "char(32)",
      "description": "最近修改人。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    }
  ]
}
