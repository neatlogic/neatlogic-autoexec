{
  "moduleId": "autoexec",
  "name": "autoexec_job_phase",
  "label": "自动化作业阶段表",
  "description": "自动化作业阶段表 可用于自动化相关的状态跟踪、时间维度统计、关联查询等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "id，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "job_id",
      "type": "bigint",
      "description": "作业id，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "剧本名。"
    },
    {
      "name": "status",
      "type": "enum('pending','running','pausing','paused','completed','failed','waiting','aborted','aborting','waitInput','ignored')",
      "description": "作业剧本状态。"
    },
    {
      "name": "start_time",
      "type": "timestamp(3)",
      "description": "开始时间。"
    },
    {
      "name": "end_time",
      "type": "timestamp(3)",
      "description": "结束时间。"
    },
    {
      "name": "exec_user",
      "type": "char(32)",
      "description": "执行人。"
    },
    {
      "name": "exec_mode",
      "type": "varchar(50)",
      "description": "执行方式 target runner。"
    },
    {
      "name": "user_name",
      "type": "varchar(50)",
      "description": "执行用户。"
    },
    {
      "name": "protocol",
      "type": "varchar(50)",
      "description": "执行协议。"
    },
    {
      "name": "round_count",
