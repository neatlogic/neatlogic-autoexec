    },
    {
      "name": "user_name_from",
      "type": "varchar(50)",
      "description": "用户来源，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "protocol_from",
      "type": "varchar(50)",
      "description": "协议来源，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "runner_group_from",
      "type": "varchar(50)",
      "description": "执行器组来源。"
    },
    {
      "name": "group_id",
      "type": "bigint",
      "description": "组id。"
    },
    {
      "name": "execute_policy",
      "type": "enum('first','middle','last')",
      "description": "执行策略。"
    },
    {
      "name": "warn_count",
      "type": "int",
      "description": "警告数量。"
    },
    {
      "name": "uuid",
      "type": "char(32)",
      "description": "前端uuid。"
    },
    {
      "name": "is_pre_output_update_node",
      "type": "tinyint(1)",
      "description": "是否通过上游参数更新执行目标。"
    }
