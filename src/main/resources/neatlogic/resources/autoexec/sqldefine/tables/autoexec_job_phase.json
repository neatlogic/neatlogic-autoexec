      "description": "分批数。"
    },
    {
      "name": "parallel_count",
      "type": "int",
      "description": "并发数。"
    },
    {
      "name": "parallel_policy",
      "type": "varchar(50)",
      "description": "并发策略。"
    },
    {
      "name": "sort",
      "type": "int",
      "description": "阶段排序。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
