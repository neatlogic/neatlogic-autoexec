  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": " idx_system_id",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "system_id"
      ],
      "description": "普通索引，覆盖 system_id 字段，适合用于过滤、关联或排序查询。"
    }
  ]
