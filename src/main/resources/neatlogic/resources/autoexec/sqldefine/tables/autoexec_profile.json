    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "名称。"
    },
    {
      "name": "description",
      "type": "text",
      "description": "描述。"
    },
    {
      "name": "config",
      "type": "longtext",
      "description": "工具参数。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "创建时间。"
    },
    {
      "name": "fcu",
      "type": "char(32)",
      "description": "创建人。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "修改时间。"
    },
    {
      "name": "lcu",
      "type": "char(32)",
      "description": "修改人。"
    },
    {
      "name": "system_id",
      "type": "bigint",
