{
  "moduleId": "autoexec",
  "name": "autoexec_profile_param",
  "label": "自动化profile参数表",
  "description": "自动化profile参数表 可用于自动化相关的关联查询等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "主键 id，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "profile_id",
      "type": "bigint",
      "description": "profile id，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "key",
      "type": "varchar(50)",
      "description": "key。"
    },
    {
      "name": "type",
      "type": "varchar(50)",
      "description": "类型。"
    },
    {
      "name": "default_value",
      "type": "text",
      "description": "默认值。"
    },
    {
      "name": "operation_id",
      "type": "bigint",
      "description": "key来源的工具id。"
    },
    {
      "name": "operation_type",
      "type": "enum('script','tool')",
      "description": "key来源的工具类型。"
    },
    {
      "name": "update_tag",
      "type": "bigint",
      "description": "修改时间。"
    },
    {
      "name": "mapping_mode",
      "type": "varchar(50)",
      "description": "值引用类型。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "idx_profile_id_key",
      "type": "BTREE",
      "unique": true,
      "primary": false,
      "columns": [
        "profile_id",
        "key"
      ],
      "description": "唯一索引，覆盖 profile_id、key 字段，适合用于精确检索、唯一性判断和去重查询。"
    }
  ]
}
