    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "名称，数据库中要求唯一，适合用于精确查询和去重判断。"
    },
    {
      "name": "color",
      "type": "varchar(50)",
      "description": "颜色。"
    },
    {
      "name": "is_active",
      "type": "tinyint(1)",
      "description": "状态是否启用 1：启用 0：禁用。"
    },
    {
      "name": "description",
      "type": "varchar(255)",
      "description": "描述。"
    },
    {
      "name": "sort",
      "type": "int",
      "description": "排序。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "创建时间。"
    },
    {
      "name": "fcu",
      "type": "char(32)",
      "description": "创建用户。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "最后修改时间。"
    },
    {
      "name": "lcu",
      "type": "char(32)",
      "description": "最后修改用户。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "uk_name",
      "type": "BTREE",
      "unique": true,
      "primary": false,
      "columns": [
        "name"
      ],
      "description": "唯一索引，覆盖 name 字段，适合用于精确检索、唯一性判断和去重查询。"
    }
  ]
