{
  "moduleId": "autoexec",
  "name": "autoexec_scenario",
  "label": "自动化场景定义表",
  "description": "自动化场景定义表 可用于自动化相关的时间维度统计等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "主键 id，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "名称。"
    },
    {
      "name": "description",
      "type": "text",
      "description": "描述。"
    },
    {
      "name": "fcu",
      "type": "char(32)",
      "description": "创建人。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "创建时间。"
    },
    {
      "name": "lcu",
      "type": "char(32)",
      "description": "修改人。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "修改时间，已建立普通索引，适合用于过滤、关联或排序查询。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "idx_lcd",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "lcd"
      ],
      "description": "普通索引，覆盖 lcd 字段，适合用于过滤、关联或排序查询。"
    }
  ]
}
