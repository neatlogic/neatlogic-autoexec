{
  "moduleId": "autoexec",
  "name": "autoexec_schedule",
  "label": "定时作业信息表",
  "description": "定时作业信息表 可用于自动化相关的启用状态筛选、时间维度统计、关联查询等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "全局唯一id，跨环境导入用，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "uuid",
      "type": "varchar(50)",
      "description": "全局唯一uuid，数据库中要求唯一，适合用于精确查询和去重判断。"
    },
    {
      "name": "name",
      "type": "varchar(100)",
      "description": "名称。"
    },
    {
      "name": "autoexec_combop_id",
      "type": "bigint",
      "description": "组合工具id。"
    },
    {
      "name": "begin_time",
      "type": "timestamp(3)",
      "description": "开始时间。"
    },
    {
      "name": "end_time",
      "type": "timestamp(3)",
      "description": "结束时间。"
    },
    {
      "name": "cron",
      "type": "varchar(200)",
      "description": "corn表达式。"
    },
    {
      "name": "is_active",
      "type": "tinyint(1)",
      "description": "0:禁用，1:激活。"
    },
    {
      "name": "config",
      "type": "mediumtext",
      "description": "执行配置信息。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "创建时间。"
    },
    {
      "name": "fcu",
      "type": "char(32)",
      "description": "创建用户。"
    },
    {
      "name": "lcd",
      "type": "timestamp",
      "description": "修改时间。"
    },
    {
      "name": "lcu",
      "type": "char(32)",
      "description": "修改用户。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "idx_uuid",
      "type": "BTREE",
      "unique": true,
      "primary": false,
      "columns": [
        "uuid"
      ],
      "description": "唯一索引，覆盖 uuid 字段，适合用于精确检索、唯一性判断和去重查询。"
    }
  ]
}
